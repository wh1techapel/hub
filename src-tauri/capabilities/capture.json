{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "capture",
  "description": "What the Catat Cepat window may do: read a line, save it, and hide itself. Nothing else.",
  "windows": [
    "capture"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-settings",
    "allow-get-shell",
    "allow-window-ready",
    "allow-hide-capture",
    "allow-read-capture",
    "allow-save-capture"
  ]
}
