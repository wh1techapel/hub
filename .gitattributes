# The skill Hub writes into Claude Code keeps LF endings in every checkout: its YAML front matter
# is read by Claude Code and checked by a test (src-tauri/src/claude_code.rs).
src-tauri/skills/** text eol=lf

# The build writes these (ts-rs bindings from `cargo test -p hub-core`, Tauri's permission files)
# with LF endings. Keeping them LF in every checkout leaves the tree clean after a test run.
src/data/generated/** text eol=lf
src-tauri/permissions/autogenerated/** text eol=lf

# The public repository is `git archive` of this one. The PSAJ school report's material names
# other people and stays private (CONTEXT.md, "Open source release").
docs/finalisasi/PSAJ_CONTEXT.md export-ignore
docs/finalisasi/PSAJ_REPORT_EVIDENCE.md export-ignore
docs/finalisasi/DEMO_PLAN.md export-ignore
docs/finalisasi/FINALIZATION_PLAN.md export-ignore
docs/finalisasi/FINAL_RELEASE_CHECKLIST.md export-ignore
docs/finalisasi/PRODUCT_AUDIT.md export-ignore
docs/finalisasi/UJI_PENGGUNA.md export-ignore
docs/finalisasi/UJI_KOMPATIBILITAS.md export-ignore
docs/finalisasi/Lembar-Uji-Pengguna-Hub.docx export-ignore
